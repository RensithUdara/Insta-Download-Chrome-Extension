{
    "manifest_version": 3,
    "name": "Instagram Downloader - Photos, Videos & Stories",
    "version": "1.1.0",
    "description": "Download photos, videos, reels, stories, and highlights from Instagram with one click. Privacy-first, no tracking, 100% local processing.",
    "permissions": [
        "downloads",
        "activeTab",
        "scripting",
        "webRequest",
        "storage",
        "tabs"
    ],
    "host_permissions": [
        "https://www.instagram.com/*",
        "https://*.cdninstagram.com/*",
        "https://*.fbcdn.net/*",
        "https://*.instagram.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        },
        "default_title": "Instagram Downloader - Photos, Videos & Stories"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.instagram.com/*",
                "https://instagram.com/*"
            ],
            "js": [
                "contentScript.js"
            ],
            "all_frames": true,
            "run_at": "document_start"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "jszip.min.js"
            ],
            "matches": [
                "https://www.instagram.com/*"
            ]
        }
    ],
    "commands": {
        "download-media": {
            "suggested_key": {
                "default": "D",
                "mac": "Command+D"
            },
            "description": "Download current media"
        },
        "toggle-select": {
            "suggested_key": {
                "default": "S",
                "mac": "Command+S"
            },
            "description": "Toggle selection mode"
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}